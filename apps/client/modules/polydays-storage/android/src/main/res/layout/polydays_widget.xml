<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/polydays_widget_background" android:clipToOutline="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FAF9F6">
    <FrameLayout android:id="@+id/polyday_selector" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:paddingStart="14dp" android:background="@drawable/polydays_widget_pressed" android:focusable="true">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/polyday_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:maxWidth="120dp" android:text="Polydays" android:textColor="#B9382E" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:layout_width="40dp" android:layout_height="match_parent" android:padding="10dp" android:src="@drawable/polydays_widget_chevron" />
      </LinearLayout>
    </FrameLayout>
    <ImageButton android:id="@+id/polyday_refresh" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:background="@drawable/polydays_widget_pressed" android:src="@drawable/polydays_widget_refresh" android:contentDescription="Обновить виджет" />
    <ImageButton android:id="@+id/polyday_add" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/polydays_widget_pressed" android:src="@drawable/polydays_widget_add" android:contentDescription="Добавить задачу в текущий полидень" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/polyday_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#EEEEEE" android:dividerHeight="1dp" android:scrollbars="none" />
  <TextView android:id="@+id/polyday_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Нет незавершённых задач" android:textColor="#66645f" android:textSize="14sp" />

  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingTop="5dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/polyday_subtitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#66645F" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/polyday_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="#66645F" android:textSize="10sp" />
  </LinearLayout>
  <TextView android:id="@+id/polyday_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B9382E" android:textSize="11sp" android:paddingHorizontal="14dp" android:paddingBottom="9dp" android:visibility="gone" />
</LinearLayout>
    <LinearLayout android:id="@+id/polyday_mode_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp" android:layout_marginTop="56dp" android:padding="4dp" android:orientation="vertical" android:background="@drawable/polydays_widget_menu" android:clipToOutline="true" android:visibility="gone">
      <TextView android:id="@+id/polyday_mode_current" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="Текущий полидень" android:textSize="14sp" android:background="@drawable/polydays_widget_pressed" />
      <TextView android:id="@+id/polyday_mode_all" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="Все полидни" android:textSize="14sp" android:background="@drawable/polydays_widget_pressed" />
    </LinearLayout>
</FrameLayout>
