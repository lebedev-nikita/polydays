<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="53dp">
    <ImageButton android:id="@+id/task_check" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/polydays_widget_pressed" android:src="@drawable/polydays_priority_4" />
    <LinearLayout android:id="@+id/task_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="53dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingVertical="10dp" android:paddingEnd="14dp" android:background="@drawable/polydays_widget_pressed">
      <TextView android:id="@+id/task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#252421" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
      <TextView android:id="@+id/task_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:paddingTop="3dp" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/task_separator" android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:importantForAccessibility="no" />
</LinearLayout>
