{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polydays",
  "version": "0.3.11",
  "identifier": "app.polydays.desktop",
  "build": { "frontendDist": "../../client/dist" },
  "app": {
    "windows": [
      {
        "title": "Polydays",
        "width": 1100,
        "height": 800,
        "minWidth": 390,
        "minHeight": 540,
        "theme": "Light"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "shortDescription": "Tasks in the rhythm of your days",
    "category": "Productivity"
  }
}
