HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/polydays.db
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:8081
# Optional trusted legacy web origins, comma-separated, during a hostname migration.
ADDITIONAL_ORIGINS=
# * permits all verified Google accounts; otherwise use comma-separated emails.
ALLOWED_EMAILS=*
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Google Cloud metadata for managing the matching OAuth clients (not application secrets).
GOOGLE_CLOUD_PROJECT=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_ANDROID_RELEASE_CLIENT_ID=
# Loaded from this root file by web/Android commands and inlined at build time.
# Set this to your HTTPS API URL for physical Android devices; see docs/deployment.md.
EXPO_PUBLIC_API_URL=
# Permanent Android release signing; keystore stays outside Git.
POLYDAYS_ANDROID_KEYSTORE=
POLYDAYS_ANDROID_STORE_PASSWORD=
POLYDAYS_ANDROID_KEY_ALIAS=
POLYDAYS_ANDROID_KEY_PASSWORD=
